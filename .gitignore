# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# --- Test / tooling caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# --- Runtime data (regenerated at runtime; never commit evidence) ---
# NOTE: leading slash anchors these to the repo root ONLY. Without it a pattern
# like "reports/" would also exclude source dirs such as app/modules/reports/.
/data/
/cases/
/samples/
/reports/
/logs/
/artifacts/
/presentation/

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# --- Secrets (must never be committed) ---
.git-credentials
.netrc
*.pem
*.key
